msgstr "Volver a Equilibrado"

#: fedoraglass/gui/qml/FedoraGlass/GlassPage.qml:60
msgid "Glass effects"
msgstr "Efectos de cristal"

#: fedoraglass/gui/qml/FedoraGlass/GlassPage.qml:61
msgid "Bend, rainbow edge, colour bleed and 2 more"
msgstr "Curvatura, borde arcoíris, difusión de color y 2 más"

#: fedoraglass/gui/qml/FedoraGlass/GlassPage.qml:76
msgid "The preview shows these as you change them."
msgstr "La vista previa los muestra mientras los cambias."

#: fedoraglass/gui/qml/FedoraGlass/GlassPage.qml:78
msgid "Drawn by Fedora Glass's own Shell extension. Apply, then restart your PC once to start it."
msgstr "Dibujado por la propia extensión de Shell de Fedora Glass. Aplica y reinicia el equipo una vez para iniciarla."

#: fedoraglass/gui/qml/FedoraGlass/GlassPage.qml:86

msgid "{path}: changed since Apply and can't be read, so it was left as it is"
msgstr "{path}: Seit dem Anwenden geändert und nicht lesbar, deshalb unverändert gelassen"

#: fedoraglass/engine.py:866
msgid "Kept your {folder} folder because it has files you added ({files}). It still uses {owner}. To get your link to {owner} back, move those files out and press Restore original again."
msgstr "Ihr Ordner {folder} wurde behalten, weil er Dateien enthält, die Sie hinzugefügt haben ({files}). Er verweist noch auf {owner}. Um Ihren Verweis auf {owner} zurückzubekommen, verschieben Sie diese Dateien heraus und klicken Sie erneut auf „Original wiederherstellen“."

#: fedoraglass/engine.py:878
msgid "Kept your {folder} folder because it has files you added. Your link to {owner} was not restored."
msgstr "Ihr Ordner {folder} wurde behalten, weil er Dateien enthält, die Sie hinzugefügt haben. Ihr Verweis auf {owner} wurde nicht wiederhergestellt."

#: fedoraglass/engine.py:880
msgid "Couldn't restore your {folder} link to {owner}: {reason}."
msgstr "Ihr Verweis von {folder} auf {owner} konnte nicht wiederhergestellt werden: {reason}."


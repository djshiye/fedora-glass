msgstr "Die GNOME-Erweiterungen wieder einschalten. Klicken Sie dann auf „Anwenden“, um Ihren Stil abzuschließen."

#: fedoraglass/gui/qml/Main.qml:540
msgid "Copy details"
msgstr "Details kopieren"

#: fedoraglass/gui/qml/Main.qml:589

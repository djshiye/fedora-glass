msgstr "1 Änderung noch nicht angewendet"

#: fedoraglass/gui/qml/Main.qml:765
msgid "%1 changes not applied yet"
msgstr "%1 Änderungen noch nicht angewendet"

#: fedoraglass/gui/qml/Main.qml:766

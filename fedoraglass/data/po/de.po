#: fedoraglass/gui/qml/FedoraGlass/LockPage.qml:251
#: fedoraglass/gui/changes.py:123
msgid "Top"
msgstr "Oben"

#: fedoraglass/gui/qml/FedoraGlass/LockPage.qml:252
msgid "In the middle of the screen. The password appears there too."
msgstr "In der Bildschirmmitte. Das Passwort erscheint dort ebenfalls."

#: fedoraglass/gui/qml/FedoraGlass/LockPage.qml:252
#: fedoraglass/gui/changes.py:123
msgid "Middle"
msgstr "Mitte"

#: fedoraglass/gui/qml/FedoraGlass/LockPage.qml:258

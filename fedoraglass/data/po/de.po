msgid "Flatpak overrides: {error}"
msgstr "Flatpak-Überschreibungen: {error}"

#: fedoraglass/engine.py:781
msgid "is now a folder, left as it is"
msgstr "ist jetzt ein Ordner, unverändert gelassen"

#: fedoraglass/engine.py:792
msgid "{path}: the saved copy of your original was lost, so this file was left as it is (it may still have the Fedora Glass look)"
msgstr "{path}: Die gespeicherte Kopie des Originals ging verloren, deshalb wurde diese Datei unverändert gelassen (sie hat womöglich noch den Fedora-Glass-Stil)"


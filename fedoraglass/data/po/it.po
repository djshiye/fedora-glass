#: fedoraglass/gui/qml/FedoraGlass/LockPage.qml:146
#: fedoraglass/gui/qml/FedoraGlass/LoginGlassCard.qml:229
msgid "Battery"
msgstr "Batteria"

#: fedoraglass/gui/qml/FedoraGlass/LockPage.qml:148
msgid "Shows your battery level and a charging sign."
msgstr "Mostra il livello della batteria e un segno di ricarica."

#: fedoraglass/gui/qml/FedoraGlass/LockPage.qml:149
msgid "Shows your battery level and a charging sign. This PC has no battery, so nothing shows."
msgstr "Mostra il livello della batteria e un segno di ricarica. Questo computer non ha una batteria, quindi non si vede nulla."

#: fedoraglass/gui/qml/FedoraGlass/LockPage.qml:154

#: fedoraglass/gui/qml/FedoraGlass/LockPage.qml:156
msgid "%1 Shows the current temperature and sky for the place set in GNOME Weather (the same weather as in the calendar menu)."
msgstr "%1 Mostra la temperatura e il cielo attuali per il luogo impostato in Meteo di GNOME (lo stesso meteo del menu del calendario)."

#: fedoraglass/gui/qml/FedoraGlass/LockPage.qml:157
msgid "Shows the current temperature and sky for the place set in GNOME Weather (the same weather as in the calendar menu)."
msgstr "Mostra la temperatura e il cielo attuali per il luogo impostato in Meteo di GNOME (lo stesso meteo del menu del calendario)."

#: fedoraglass/gui/qml/FedoraGlass/LockPage.qml:162
msgid "Greeting"
msgstr "Saluto"

#: fedoraglass/gui/qml/FedoraGlass/LockPage.qml:164

#!/bin/bash
# fedora-glass-sign: signs Fedora Glass releases with your own OpenPGP key, on your own
# PC, and publishes them to the dnf (Fedora), apt (Ubuntu) and pacman (Arch) repositories.
# The private key never leaves this PC:
# GitHub only ever sees signed packages and your public key.
#
#   fedora-glass-sign setup [KEY]     once: pick your key and save its public half
#   fedora-glass-sign backup DIR      once: encrypted copy of your private key (USB stick)
#   fedora-glass-sign [vX.Y.Z]        sign a release and publish it (default: latest)
#   fedora-glass-sign enable-auto     once: from now on, sign each new release by itself
#   fedora-glass-sign disable-auto    stop doing that
#
# A new release is a draft until it is signed: this publishes it at the end.
#
# Needs: sudo dnf install rpm-sign createrepo_c gh   (and `gh auth login` once)
set -euo pipefail
umask 077

REPO=djshiye/fedora-glass
KEYFILE=RPM-GPG-KEY-fedora-glass
CONF="${XDG_CONFIG_HOME:-$HOME/.config}/fedora-glass-signing"
SITE=https://djshiye.github.io/fedora-glass

say()  { printf '\033[1m%s\033[0m\n' "$*"; }
die()  { printf '\033[1;31mStopped:\033[0m %s\n' "$*" >&2; exit 1; }
need() { for t in "$@"; do command -v "$t" >/dev/null || die "$t is missing. Run: sudo dnf install rpm-sign createrepo_c gh"; done; }

# Builds the apt and pacman indexes (a copy of packaging/repo_index.py, kept the same by
# tests/test_distro.py). Standard library Python only, run with -I.
repo_index() { python3 -I -c "$REPO_INDEX_PY" "$@"; }
# REPO_INDEX start
REPO_INDEX_PY=$(cat <<'REPO_INDEX_EOF'
"""Repository indexes for the Ubuntu (apt) and Arch (pacman) packages, standard library only.

fedora-glass-sign carries a copy of this file (between its REPO_INDEX markers) and runs it
with python3 -I on Dino's PC, so signing needs nothing beyond gpg and Python. Keep the two
the same: tests/test_distro.py checks that they are.

  repo_index.py deb-info FILE.deb        prints "name version"
  repo_index.py pkg-info FILE.pkg.tar.xz prints "name version"
  repo_index.py apt DIR                  writes DIR/Packages, Packages.gz and Release
  repo_index.py arch DIR NAME            writes DIR/NAME.db (and NAME.db.tar.gz); every
                                         package needs its detached .sig next to it already
"""
import base64
import gzip
import hashlib
import io
import lzma
import os
import re
import sys
import tarfile
import time

NAME = re.compile(r"[a-z0-9][a-z0-9.+_-]*")
VERSION = re.compile(r"[0-9A-Za-z.:~+_-]+")
MAX = 64 << 20


def _read(path):
    if os.path.getsize(path) > MAX:
        raise SystemExit(f"{path} is too big")
    with open(path, "rb") as f:
        return f.read()


def _members(blob):
    """The members of an ar archive (a .deb), as (name, data)."""
    if not blob.startswith(b"!<arch>\n"):
        raise SystemExit("not a .deb (ar) file")
    pos, out = 8, []
    while pos + 60 <= len(blob):
        head = blob[pos:pos + 60]
        name = head[:16].decode().strip().rstrip("/")
        size = int(head[48:58].decode().strip())
        out.append((name, blob[pos + 60:pos + 60 + size]))
        pos += 60 + size + (size & 1)
    return out


def deb_control(path):
    """The control file of a .deb, as (text, fields)."""
    for name, data in _members(_read(path)):
        if name == "control.tar.xz":
            raw = lzma.decompress(data)
        elif name == "control.tar.gz":
            raw = gzip.decompress(data)
        elif name.startswith("control.tar"):
            raise SystemExit(f"{path}: unsupported {name} (build with dpkg-deb -Zxz)")
        else:
            continue
        with tarfile.open(fileobj=io.BytesIO(raw)) as t:
            for m in t.getmembers():
                if m.isfile() and m.name.lstrip("./") == "control":
                    text = t.extractfile(m).read().decode()
                    fields = {}
                    for line in text.splitlines():
                        if line[:1] not in (" ", "\t") and ":" in line:
                            k, _, v = line.partition(":")
                            fields[k.strip()] = v.strip()
                    return text.strip() + "\n", fields
    raise SystemExit(f"{path} has no control file")


def pkginfo(path):
    """.PKGINFO of an Arch package (xz), as a dict of lists."""
    raw = _read(path)
    with tarfile.open(fileobj=io.BytesIO(lzma.decompress(raw))) as t:
        m = t.getmember(".PKGINFO")
        text = t.extractfile(m).read().decode()
    info = {}
    for line in text.splitlines():
        if line.startswith("#") or " = " not in line:
            continue
        k, _, v = line.partition(" = ")
        info.setdefault(k.strip(), []).append(v.strip())
    return info


def _checked(name, version):
    if not NAME.fullmatch(name) or not VERSION.fullmatch(version):
        raise SystemExit(f"bad package name or version: {name!r} {version!r}")
    return name, version


def deb_info(path):
    _, f = deb_control(path)
    return _checked(f.get("Package", ""), f.get("Version", ""))


def pkg_info(path):
    i = pkginfo(path)
    return _checked(i.get("pkgname", [""])[0], i.get("pkgver", [""])[0])


def apt_index(d):
    debs = sorted(n for n in os.listdir(d) if n.endswith(".deb"))
    if not debs:
        raise SystemExit("no .deb files")
    stanzas = []
    for n in debs:
        p = os.path.join(d, n)
        text, _ = deb_control(p)
        blob = _read(p)
        stanzas.append(text + f"Filename: ./{n}\nSize: {len(blob)}\n"
                       f"MD5sum: {hashlib.md5(blob).hexdigest()}\n"
                       f"SHA256: {hashlib.sha256(blob).hexdigest()}\n")
    packages = "\n".join(stanzas).encode()
    files = {"Packages": packages, "Packages.gz": gzip.compress(packages, mtime=0)}
    for name, data in files.items():
        with open(os.path.join(d, name), "wb") as f:
            f.write(data)
    date = time.strftime("%a, %d %b %Y %H:%M:%S UTC", time.gmtime(int(os.environ.get("SOURCE_DATE_EPOCH", time.time()))))
    rel = ["Origin: Fedora Glass", "Label: Fedora Glass", "Architectures: all", f"Date: {date}",
           "Acquire-By-Hash: no", "SHA256:"]
    rel += [f" {hashlib.sha256(v).hexdigest()} {len(v)} {k}" for k, v in files.items()]
    with open(os.path.join(d, "Release"), "w") as f:
        f.write("\n".join(rel) + "\n")


DESC = [("FILENAME", None), ("NAME", "pkgname"), ("BASE", "pkgbase"), ("VERSION", "pkgver"),
        ("DESC", "pkgdesc"), ("GROUPS", "group"), ("CSIZE", None), ("ISIZE", "size"),
        ("SHA256SUM", None), ("PGPSIG", None), ("URL", "url"), ("LICENSE", "license"),
        ("ARCH", "arch"), ("BUILDDATE", "builddate"), ("PACKAGER", "packager"),
        ("REPLACES", "replaces"), ("CONFLICTS", "conflict"), ("PROVIDES", "provides"),
        ("DEPENDS", "depend"), ("OPTDEPENDS", "optdepend"), ("MAKEDEPENDS", "makedepend"),
        ("CHECKDEPENDS", "checkdepend")]


def _vkey(ver):
    """Sort key for our own versions (1.5.16-1): numbers compare as numbers."""
    return [int(x) if x.isdigit() else -1 for x in re.split(r"[.:-]", ver)]


def arch_db(d, repo):
    pkgs = sorted(n for n in os.listdir(d) if n.endswith(".pkg.tar.xz"))
    if not pkgs:
        raise SystemExit("no .pkg.tar.xz files")
    # A pacman database holds one version of each package: the newest. The older files
    # stay on the site, for `pacman -U <url>` to go back by hand.
    newest = {}
    for n in pkgs:
        name, ver = pkg_info(os.path.join(d, n))
        if name not in newest or _vkey(ver) > _vkey(newest[name][1]):
            newest[name] = (n, ver)
    pkgs = sorted(n for n, _ in newest.values())
    buf = io.BytesIO()
    mtime = int(os.environ.get("SOURCE_DATE_EPOCH", time.time()))
    with tarfile.open(fileobj=buf, mode="w:gz", format=tarfile.USTAR_FORMAT) as t:
        for n in pkgs:
            p = os.path.join(d, n)
            blob = _read(p)
            sig = _read(p + ".sig")
            info = pkginfo(p)
            name, ver = _checked(info["pkgname"][0], info["pkgver"][0])
            own = {"FILENAME": [n], "CSIZE": [str(len(blob))],
                   "SHA256SUM": [hashlib.sha256(blob).hexdigest()],
                   "PGPSIG": [base64.b64encode(sig).decode()]}
            out = []
            for key, src in DESC:
                vals = own.get(key) if src is None else info.get(src, [])
                if key == "BASE" and not vals:
                    vals = [name]
                if vals:
                    out.append(f"%{key}%\n" + "\n".join(vals) + "\n")
            data = ("\n".join(out) + "\n").encode()
            top = f"{name}-{ver}"
            di = tarfile.TarInfo(top)
            di.type, di.mode, di.mtime = tarfile.DIRTYPE, 0o755, mtime
            t.addfile(di)
            fi = tarfile.TarInfo(f"{top}/desc")
            fi.size, fi.mode, fi.mtime = len(data), 0o644, mtime
            t.addfile(fi, io.BytesIO(data))
    for name in (f"{repo}.db", f"{repo}.db.tar.gz"):
        with open(os.path.join(d, name), "wb") as f:
            f.write(buf.getvalue())


def main(argv):
    if len(argv) >= 2 and argv[0] == "deb-info":
        print(*deb_info(argv[1]))
    elif len(argv) >= 2 and argv[0] == "pkg-info":
        print(*pkg_info(argv[1]))
    elif len(argv) >= 2 and argv[0] == "apt":
        apt_index(argv[1])
    elif len(argv) >= 3 and argv[0] == "arch":
        arch_db(argv[1], argv[2])
    else:
        raise SystemExit(__doc__)


if __name__ == "__main__":
    main(sys.argv[1:])
REPO_INDEX_EOF
)
# REPO_INDEX end

work=""
cleanup() { if [ -n "$work" ] && [ -d "$work" ]; then rm -rf -- "$work"; fi; }
trap cleanup EXIT
newwork() { work="$(mktemp -d "${XDG_RUNTIME_DIR:-/tmp}/fedora-glass-sign.XXXXXX")"; }

# Primary key fingerprints of usable signing keys in your keyring (not expired or revoked).
signing_keys() {
    gpg --batch --with-colons --list-secret-keys 2>/dev/null | awk -F: '
        $1 == "sec" { ok = ($2 !~ /[erd]/ && $12 ~ /S/); want = 1; next }
        $1 == "fpr" && want { if (ok) print $10; want = 0 }'
}

saved_key() {
    [ -s "$CONF/key-fingerprint" ] || die "run 'fedora-glass-sign setup' first."
    fpr="$(cat "$CONF/key-fingerprint")"
    signing_keys | grep -qx "$fpr" || die "your signing key $fpr is not in this PC's keyring any more. If it is lost, see 'Lost key' in docs/SIGNING.md."
}

# Fingerprints (primary keys) in an armored public key file.
key_fprs() {
    gpg --batch --with-colons --import-options show-only --import "$1" 2>/dev/null \
        | awk -F: '$1 == "pub" { want = 1; next } $1 == "fpr" && want { print $10; want = 0 }'
}

cmd_setup() {
    need gpg
    mapfile -t keys < <(signing_keys)
    if [ $# -ge 1 ]; then
        fpr="$(gpg --batch --with-colons --list-secret-keys "$1" 2>/dev/null | awk -F: '$1 == "fpr" { print $10; exit }')"
        [ -n "$fpr" ] && printf '%s\n' "${keys[@]}" | grep -qx "$fpr" || die "no usable signing key matches '$1'."
    elif [ ${#keys[@]} -eq 1 ]; then
        fpr="${keys[0]}"
    elif [ ${#keys[@]} -eq 0 ]; then
        die "no signing key found in your keyring (gpg --list-secret-keys shows none that can sign)."
    else
        say "You have more than one signing key. Run setup again with the one to use:"
        for k in "${keys[@]}"; do
            printf '  fedora-glass-sign setup %s   (%s)\n' "$k" \
                "$(gpg --batch --with-colons --list-keys "$k" | awk -F: '$1 == "uid" { print $10; exit }')"
        done
        exit 1
    fi
    mkdir -p "$CONF"
    say "Checking that the key can sign (gpg may ask for its passphrase)..."
    echo fedora-glass | gpg --batch=no --quiet -u "$fpr" --detach-sign >/dev/null || die "signing a test text failed."
    echo "$fpr" > "$CONF/key-fingerprint"
    gpg --batch --armor --export-options export-minimal --export "$fpr" > "$CONF/$KEYFILE"
    chmod 644 "$CONF/$KEYFILE"
    say "Done. Your signing key:"
    gpg --batch --list-keys --keyid-format long "$fpr" | sed -n '1,3p'
    echo
    echo "Public key (safe to share): $CONF/$KEYFILE"
    echo "Next: make a backup with   fedora-glass-sign backup /run/media/${USER:-you}/<your USB stick>"
}

cmd_backup() {
    [ $# -eq 1 ] || die "say where to put the backup, for example: fedora-glass-sign backup /run/media/${USER:-you}/USB"
    need gpg
    saved_key
    dir="$1"
    [ -d "$dir" ] && [ -w "$dir" ] || die "$dir is not a folder you can write to."
    case "$(realpath "$dir")/" in
        "$(realpath "$HOME")"/*) say "Note: $dir is inside your home folder. Copy the backup to a USB stick or your password manager too, so a reset can't take it." ;;
    esac
    out="$dir/fedora-glass-signing-key-backup.asc"
    [ ! -e "$out" ] || die "$out already exists. Pick another folder or move the old one away first."
    newwork
    say "Exporting your private key (gpg may ask for the key's passphrase)..."
    gpg --batch=no --armor --export-secret-keys "$fpr" > "$work/secret.asc"
    [ -s "$work/secret.asc" ] || die "the export came out empty."
    say "Now choose a NEW password for the backup file. Store it in your password manager."
    gpg --batch=no --symmetric --armor --cipher-algo AES256 -o "$out" "$work/secret.asc"
    shred -u "$work/secret.asc" 2>/dev/null || rm -f "$work/secret.asc"
    chmod 600 "$out"
    rev="${GNUPGHOME:-$HOME/.gnupg}/openpgp-revocs.d/$fpr.rev"
    if [ -f "$rev" ]; then cp "$rev" "$dir/fedora-glass-signing-key-revoke.rev"; chmod 600 "$dir/fedora-glass-signing-key-revoke.rev"; fi
    say "Backup written: $out"
    echo "To restore it on a new PC:  gpg -d '$out' | gpg --import   then  fedora-glass-sign setup"
}

# Exit code 3 means: the release failed a provenance check, so nothing was signed.
refuse() { printf '\033[1;31mNOT signed:\033[0m %s\n' "$*" >&2; exit 3; }

# The commit a release tag points at (through an annotated tag, if it is one).
tag_commit() {
    local obj type sha _
    obj="$(gh api "repos/$REPO/git/ref/tags/$1" --jq '.object.type + " " + .object.sha' 2>/dev/null)" || return 1
    for _ in 1 2 3; do
        read -r type sha <<<"$obj"
        [[ "$sha" =~ ^[0-9a-f]{40}$ ]] || return 1
        if [ "$type" = commit ]; then echo "$sha"; return 0; fi
        [ "$type" = tag ] || return 1
        obj="$(gh api "repos/$REPO/git/tags/$sha" --jq '.object.type + " " + .object.sha' 2>/dev/null)" || return 1
    done
    return 1
}

# Before anything is signed: the tag must point at a commit that is on main. Sets $sha.
check_on_main() {
    sha="$(tag_commit "$1")" || refuse "could not find the commit of tag $1 on GitHub."
    local st
    st="$(gh api "repos/$REPO/compare/main...$sha" --jq .status 2>/dev/null)" || refuse "could not check that $1 is on main."
    case "$st" in
        behind|identical) ;;   # the commit is main, or an older commit of main
        *) refuse "$1 ($sha) is not on main (GitHub says: ${st:-nothing})." ;;
    esac
}

# The file has a build provenance attestation (Sigstore) saying that this repository's
# Release workflow built it from commit $sha, on GitHub's own runners: run for the tag
# itself (a pushed tag) or on main (a release started from the Actions tab). The
# certificate identity is matched exactly, not as a prefix.
attested() {
    local ref
    for ref in "refs/tags/$2" refs/heads/main; do
        gh attestation verify "$1" --repo "$REPO" \
            --cert-identity "https://github.com/$REPO/.github/workflows/release.yml@$ref" \
            --source-ref "$ref" --source-digest "$sha" --deny-self-hosted-runners >/dev/null 2>&1 && return 0
    done
    return 1
}

# Lists the paths in a repository bundle, refusing links, devices and odd names
# (the same rules as dnf-repo.yml).
bundle_ok() {
    tar -tvzf "$1" > "$work/bundle.lst" 2>/dev/null || return 1
    awk '{ print substr($1, 1, 1) }' "$work/bundle.lst" > "$work/bundle.types"
    ! grep -qv '^[-d]$' "$work/bundle.types" || return 1
    tar -tzf "$1" > "$work/bundle.names" || return 1
    ! grep -Evx 'rpms/?|rpms/repodata/?|rpms/[A-Za-z0-9._+~^-]+\.rpm|rpms/repodata/[A-Za-z0-9._-]+|apt/?|apt/[A-Za-z0-9._+~-]+|arch/?|arch/[A-Za-z0-9._+~-]+' "$work/bundle.names" >/dev/null || return 1
    ! grep -Eq '(^|/)\.\.?(/|$)' "$work/bundle.names"
}

# The older releases in the window (so `dnf downgrade` can roll back) are not signed
# again. Their packages come from the newest earlier signed repository (the
# dnf-repo.tar.gz on an older release, which is what the site published), and each one
# is kept only if your key's signature on it (or, for Ubuntu, on the index that lists
# its hash) verifies and its name and version belong to one of those releases.
carry_over() {
    local from="" t p n pn pv h want a kept=0
    [ -n "$older" ] || return 0
    for t in $older; do
        rm -rf "$work/old"; mkdir -p "$work/old"
        if gh release download "$t" --repo "$REPO" -D "$work/old" -p dnf-repo.tar.gz 2>/dev/null; then from="$t"; break; fi
    done
    if [ -z "$from" ]; then say "No earlier signed repository on GitHub: publishing only $tag."; return 0; fi
    bundle_ok "$work/old/dnf-repo.tar.gz" || die "the signed repository of $from has unexpected files in it."
    mkdir -p "$work/old/x"
    tar -xzf "$work/old/dnf-repo.tar.gz" -C "$work/old/x" --no-same-owner --no-same-permissions
    for p in "$work"/old/x/rpms/*.rpm; do
        [ -f "$p" ] || continue
        rpmkeys --root "$work/root" --define '_pkgverify_level all' --checksig "$p" >/dev/null 2>&1 \
            || { say "Not kept (not signed by your key): $(basename "$p")"; continue; }
        read -r pn pv < <(rpm -qp --nosignature --qf '%{name} v%{version}\n' "$p") || continue
        case "$pn" in fedora-glass|liquid-glass) ;; *) continue ;; esac
        case " $older " in *" $pv "*) ;; *) continue ;; esac
        n="$(rpm -qp --nosignature --qf '%{name}-%{version}-%{release}' "$p").noarch.rpm"
        [ -e "$work/site/rpms/$n" ] || { cp "$p" "$work/site/rpms/$n"; kept=$((kept + 1)); }
    done
    # Ubuntu: a .deb carries no signature of its own; its hash is in the signed index.
    a="$work/old/x/apt"
    if [ -f "$a/Release" ] && [ -f "$a/Release.gpg" ] && [ -f "$a/Packages" ] \
       && gpgv --keyring "$work/main.gpg" "$a/Release.gpg" "$a/Release" 2>/dev/null \
       && grep -Eqx " $(sha256sum < "$a/Packages" | cut -d' ' -f1) [0-9]+ Packages" "$a/Release"; then
        for p in "$a"/*.deb; do
            [ -f "$p" ] || continue
            want="$(awk -v f="./$(basename "$p")" '
                /^Filename: / { fn = $2 } /^SHA256: / { h = $2 }
                /^$/ { if (fn == f) print h; fn = h = "" }
                END { if (fn == f) print h }' "$a/Packages")"
            h="$(sha256sum < "$p" | cut -d' ' -f1)"
            [ -n "$want" ] && [ "$h" = "$want" ] || { say "Not kept (not in the signed apt index): $(basename "$p")"; continue; }
            read -r pn pv < <(repo_index deb-info "$p") || continue
            [ "$pn" = fedora-glass ] || continue
            case " $older " in *" v${pv%-*} "*) ;; *) continue ;; esac
            n="fedora-glass_${pv}_all.deb"
            [ -e "$work/site/apt/$n" ] || { cp "$p" "$work/site/apt/$n"; kept=$((kept + 1)); }
        done
    fi
    # Arch: each package has its own signature.
    for p in "$work"/old/x/arch/*.pkg.tar.xz; do
        [ -f "$p" ] || continue
        if ! { [ -f "$p.sig" ] && gpgv --keyring "$work/main.gpg" "$p.sig" "$p" 2>/dev/null; }; then
            say "Not kept (not signed by your key): $(basename "$p")"; continue
        fi
        read -r pn pv < <(repo_index pkg-info "$p") || continue
        [ "$pn" = fedora-glass ] || continue
        case " $older " in *" v${pv%-*} "*) ;; *) continue ;; esac
        n="fedora-glass-${pv}-any.pkg.tar.xz"
        [ -e "$work/site/arch/$n" ] || { cp "$p" "$work/site/arch/$n"; cp "$p.sig" "$work/site/arch/$n.sig"; kept=$((kept + 1)); }
    done
    say "Kept $kept already signed packages of the releases before $tag (from the signed repository of $from)."
}

cmd_publish() {
    need gpg gpgv rpmsign rpm rpmkeys createrepo_c gh sha256sum tar python3
    saved_key
    gh auth status >/dev/null 2>&1 || die "gh is not signed in. Run: gh auth login"
    gh attestation verify --help >/dev/null 2>&1 || die "this gh is too old to check build provenance. Run: sudo dnf upgrade gh"
    newwork

    # The public key on main must be this key, or dnf would refuse what we sign.
    gh api -H 'Accept: application/vnd.github.raw' "repos/$REPO/contents/packaging/$KEYFILE?ref=main" > "$work/main.key" 2>/dev/null \
        || die "main has no packaging/$KEYFILE yet. Send Claude your public key ($CONF/$KEYFILE) first."
    key_fprs "$work/main.key" > "$work/main.fprs"
    grep -qx "$fpr" "$work/main.fprs" || die "the public key on main is not your key $fpr."
    gpg --batch --dearmor < "$work/main.key" > "$work/main.gpg"
    mkdir -p "$work/root"
    rpmkeys --root "$work/root" --import "$work/main.key"

    tag="${1:-$(newest_release | cut -d' ' -f1)}"
    case "$tag" in v[0-9]*) ;; *) die "not a release tag: $tag" ;; esac
    # This release and the two before it, so `dnf downgrade` can roll back. The release
    # workflow makes the new release as a draft, so it counts while it is still one; an
    # older draft (a release that never got signed) does not.
    tags="$(gh release list --repo "$REPO" --exclude-pre-releases --limit 100 --json tagName,isDraft -q '.[] | "\(.tagName) \(.isDraft)"' \
            | awk -v t="$tag" '$2 == "false" || $1 == t { print $1 }' \
            | grep -E '^v[0-9]' | sort -rV | awk -v t="$tag" 'f || $0 == t { f = 1; print }' | head -3)"
    [ "$(echo "$tags" | head -1)" = "$tag" ] || die "there is no release $tag."
    older="$(echo "$tags" | tail -n +2 | tr '\n' ' ')"

    # Nothing of this release is signed unless its tag is on main and every package was
    # built by the Release workflow from that commit (a checksum file on the same
    # release proves nothing about who uploaded it).
    check_on_main "$tag"

    mkdir -p "$work/site/rpms" "$work/site/apt" "$work/site/arch"
    d="$work/dl/$tag"; mkdir -p "$d"
    gh release download "$tag" --repo "$REPO" -D "$d" -p SHA256SUMS 2>/dev/null || die "$tag has no SHA256SUMS."
    for n in fedora-glass.noarch.rpm liquid-glass.noarch.rpm fedora-glass.deb fedora-glass.pkg.tar.xz; do
        grep -q " $n\$" "$d/SHA256SUMS" || continue
        gh release download "$tag" --repo "$REPO" -D "$d" -p "$n" || die "could not download $n from $tag."
        (cd "$d" && grep " $n\$" SHA256SUMS | sha256sum --quiet -c -) || die "$tag $n does not match its SHA256SUMS."
        f="$d/$n"
        attested "$f" "$tag" || refuse "$tag $n has no build provenance from the Release workflow for commit $sha (gh attestation verify failed)."
        case "$n" in
            *.rpm)
                want="${n%%.noarch.rpm}"
                [ "$(rpm -qp --nosignature --qf '%{name} v%{version}' "$f")" = "$want $tag" ] || die "$tag $n is not $want $tag."
                cp "$f" "$work/site/rpms/$(rpm -qp --nosignature --qf '%{name}-%{version}-%{release}' "$f").noarch.rpm" ;;
            *.deb)
                read -r pn pv < <(repo_index deb-info "$f") || die "$tag $n can't be read."
                [ "$pn" = fedora-glass ] && [ "${pv%-*}" = "${tag#v}" ] || die "$tag $n is not fedora-glass $tag."
                cp "$f" "$work/site/apt/fedora-glass_${pv}_all.deb" ;;
            *.pkg.tar.xz)
                read -r pn pv < <(repo_index pkg-info "$f") || die "$tag $n can't be read."
                [ "$pn" = fedora-glass ] && [ "${pv%-*}" = "${tag#v}" ] || die "$tag $n is not fedora-glass $tag."
                cp "$f" "$work/site/arch/fedora-glass-${pv}-any.pkg.tar.xz" ;;
        esac
    done
    ls "$work"/site/rpms/fedora-glass-"${tag#v}"-*.noarch.rpm >/dev/null 2>&1 || die "$tag has no fedora-glass RPM."

    # Only this release's packages are signed now; the older ones are already signed.
    say "Signing $(ls "$work/site/rpms" | wc -l) packages for $tag (gpg may ask for your passphrase)..."
    rpmsign --define "_openpgp_sign_id $fpr" --define "_gpg_name $fpr" --addsign "$work"/site/rpms/*.rpm >/dev/null
    for p in "$work"/site/arch/*.pkg.tar.xz; do
        [ -f "$p" ] || continue
        gpg --batch=no --quiet --yes -u "$fpr" --digest-algo SHA512 --detach-sign -o "$p.sig" "$p"
        gpgv --keyring "$work/main.gpg" "$p.sig" "$p" 2>/dev/null || die "$(basename "$p") did not verify after signing."
    done
    carry_over

    # Check every package the way dnf will: with only your public key trusted.
    for p in "$work"/site/rpms/*.rpm; do
        rpmkeys --root "$work/root" --define '_pkgverify_level all' --checksig "$p" >/dev/null || die "$(basename "$p") did not verify after signing."
    done

    createrepo_c --quiet "$work/site/rpms"
    gpg --batch=no --quiet --yes -u "$fpr" --armor --detach-sign "$work/site/rpms/repodata/repomd.xml"
    gpgv --keyring "$work/main.gpg" "$work/site/rpms/repodata/repomd.xml.asc" "$work/site/rpms/repodata/repomd.xml" 2>/dev/null \
        || die "the repository signature did not verify."

    # Ubuntu: apt checks the signed index (InRelease), which holds the hash of each package.
    parts=rpms
    if ls "$work"/site/apt/*.deb >/dev/null 2>&1; then
        SOURCE_DATE_EPOCH="$(date +%s)" repo_index apt "$work/site/apt"
        gpg --batch=no --quiet --yes -u "$fpr" --digest-algo SHA512 --clearsign -o "$work/site/apt/InRelease" "$work/site/apt/Release"
        gpg --batch=no --quiet --yes -u "$fpr" --digest-algo SHA512 --armor --detach-sign -o "$work/site/apt/Release.gpg" "$work/site/apt/Release"
        gpgv --keyring "$work/main.gpg" "$work/site/apt/InRelease" 2>/dev/null || die "the apt index signature did not verify."
        parts="$parts apt"
    fi
    # Arch: pacman checks each package's own signature and the signed database.
    if ls "$work"/site/arch/*.pkg.tar.xz >/dev/null 2>&1; then
        for p in "$work"/site/arch/*.pkg.tar.xz; do
            gpgv --keyring "$work/main.gpg" "$p.sig" "$p" 2>/dev/null || die "$(basename "$p") is not signed by your key."
        done
        SOURCE_DATE_EPOCH="$(date +%s)" repo_index arch "$work/site/arch" fedora-glass
        for db in fedora-glass.db fedora-glass.db.tar.gz; do
            gpg --batch=no --quiet --yes -u "$fpr" --digest-algo SHA512 --detach-sign -o "$work/site/arch/$db.sig" "$work/site/arch/$db"
        done
        gpgv --keyring "$work/main.gpg" "$work/site/arch/fedora-glass.db.sig" "$work/site/arch/fedora-glass.db" 2>/dev/null \
            || die "the pacman database signature did not verify."
        parts="$parts arch"
    fi

    # shellcheck disable=SC2086
    tar -C "$work/site" --owner=0 --group=0 --numeric-owner -czf "$work/dnf-repo.tar.gz" $parts
    say "Uploading the signed repository to release $tag..."
    gh release upload "$tag" "$work/dnf-repo.tar.gz" --repo "$REPO" --clobber
    # The release workflow keeps a new release a draft, so nobody can install its unsigned
    # packages from the release page: it goes public only now, after every check passed and
    # the signed repository is uploaded. A release that is public already (made by an older
    # workflow) is left as it is.
    if [ "$(gh release view "$tag" --repo "$REPO" --json isDraft -q .isDraft)" = true ]; then
        say "Publishing release $tag..."
        gh release edit "$tag" --repo "$REPO" --draft=false
    fi
    gh workflow run dnf-repo.yml --repo "$REPO" --ref main -f tag="$tag"
    # For `auto`: when this publish started, and that it has not been retried yet.
    : > "$CONF/publishing-$tag"
    rm -f "$CONF/publish-tries-$tag" "$CONF/publish-gave-up-$tag"
    say "Done. GitHub is publishing it now (about 2 minutes): https://github.com/$REPO/actions/workflows/dnf-repo.yml"
    echo "Then: sudo dnf upgrade --refresh  (Ubuntu: sudo apt update && sudo apt upgrade, Arch: sudo pacman -Syu)"
}

# The newest release, drafts included (a plain `gh release view` skips them), as "TAG isDraft".
newest_release() {
    gh release list --repo "$REPO" --exclude-pre-releases --limit 1 --json tagName,isDraft -q '.[] | "\(.tagName) \(.isDraft)"'
}

notify() {
    command -v notify-send >/dev/null || return 0
    notify-send -a "Fedora Glass" -i io.github.djshiye.LiquidGlass "$1" "${2:-}" 2>/dev/null || :
}

# How many times `auto` starts the publish workflow again when the site stays behind.
PUBLISH_TRIES=3

# The release has its signed repository: is the site serving it? Says "published" once
# it is, and if it is not, starts the publish workflow again (it sometimes times out),
# at most PUBLISH_TRIES times, at least 20 minutes apart.
site_check() {
    local tag="$1" v="${1#v}" served runs n marker="$CONF/publishing-$1" tries="$CONF/publish-tries-$1" gaveup="$CONF/publish-gave-up-$1"
    served="$(curl -fsS --max-time 30 "$SITE/version.txt?t=$(date +%s)" 2>/dev/null)" || return 0   # offline: later
    served="${served%%[[:space:]]*}"
    [[ "$served" =~ ^[0-9A-Za-z.:~^_+-]+$ ]] || return 0
    if [ "${served%-*}" = "$v" ]; then
        if [ -f "$marker" ]; then
            rm -f "$marker" "$tries" "$gaveup"
            notify "Fedora Glass $v is published" "sudo dnf upgrade (apt upgrade, pacman -Syu) picks it up now."
        fi
        return 0
    fi
    # The site serves something newer than this release: nothing to do.
    [ "$(printf '%s\n%s\n' "${served%-*}" "$v" | sort -V | tail -1)" = "$v" ] || return 0
    # A publish run is still going (or waiting): let it finish.
    runs="$(gh run list --repo "$REPO" --workflow dnf-repo.yml --limit 5 --json status -q '.[].status' 2>/dev/null)" || return 0
    if [ -n "$runs" ] && grep -qvx completed <<<"$runs"; then return 0; fi
    # Pages and its cache take a few minutes after a run.
    if [ -f "$marker" ] && [ $(( $(date +%s) - $(stat -c %Y "$marker") )) -lt 1200 ]; then return 0; fi
    n="$(cat "$tries" 2>/dev/null || :)"
    [[ "$n" =~ ^[0-9]+$ ]] || n=0
    if [ "$n" -ge "$PUBLISH_TRIES" ]; then
        [ -f "$gaveup" ] && return 0
        : > "$gaveup"
        notify "Fedora Glass $v is signed but NOT published" "Publishing failed $((n + 1)) times, so it is not tried again. See https://github.com/$REPO/actions/workflows/dnf-repo.yml"
        return 1
    fi
    gh workflow run dnf-repo.yml --repo "$REPO" --ref main -f tag="$tag" >/dev/null 2>&1 || return 0
    echo $((n + 1)) > "$tries"
    : > "$marker"
    notify "Fedora Glass $v is signed, publishing again" "The website did not get it last time (try $((n + 1)) of $PUBLISH_TRIES)."
}

# Run by the systemd user timer: if the newest release has no signed repository yet,
# sign and publish it; if it has one but the site is behind, publish it again.
# Quiet when there is nothing to do or GitHub can't be reached.
cmd_auto() {
    need gpg gpgv rpmsign rpm rpmkeys createrepo_c gh sha256sum tar flock python3 curl
    saved_key
    exec 9>"$CONF/auto.lock"
    flock -n 9 || exit 0
    newest="$(newest_release 2>/dev/null)" || exit 0
    read -r tag draft <<<"$newest"
    case "$tag" in v[0-9]*) ;; *) exit 0 ;; esac
    assets="$(gh release view "$tag" --repo "$REPO" --json assets -q '.assets[].name' 2>/dev/null)" || exit 0
    # A draft is signed (again, if an earlier run stopped before publishing it) and then
    # published; only a public release can already be on the site.
    if [ "$draft" != true ] && grep -qx dnf-repo.tar.gz <<<"$assets"; then site_check "$tag"; exit; fi
    # Only once the release has its checksums (the Release workflow adds them with the RPMs).
    grep -qx SHA256SUMS <<<"$assets" || exit 0
    # After a failure (or a cancelled passphrase prompt) wait an hour before the next try.
    failed="$CONF/auto-failed-$tag"
    if [ -f "$failed" ] && [ $(( $(date +%s) - $(stat -c %Y "$failed") )) -lt 3600 ]; then exit 0; fi
    if "$(readlink -f "$0")" "$tag" > "$CONF/auto.log" 2>&1; then
        rm -f "$failed"
        notify "Fedora Glass ${tag#v} is signed, publishing it now" "You get another notification once it is published."
    else
        rc=$?
        touch "$failed"
        why="$(grep -v '^$' "$CONF/auto.log" | tail -1 | sed 's/\x1b\[[0-9;]*m//g')"
        [ -n "$why" ] || why="see $CONF/auto.log"
        if [ "$rc" -eq 3 ]; then
            notify "Fedora Glass ${tag#v} was NOT signed" "${why#NOT signed: }"
        else
            notify "Fedora Glass ${tag#v} could not be signed yet" "${why%.}. Trying again in an hour."
        fi
        exit 1
    fi
}

cmd_enable_auto() {
    need gpg rpmsign createrepo_c gh flock systemctl
    saved_key
    gh auth status >/dev/null 2>&1 || die "gh is not signed in. Run: gh auth login"
    self="$(readlink -f "$0")"
    units="${XDG_CONFIG_HOME:-$HOME/.config}/systemd/user"
    mkdir -p "$units"
    say "Unlocking your key once (if a password window opens, tick 'Save in password manager')..."
    gpg-connect-agent reloadagent /bye >/dev/null 2>&1 || :   # ask now, not from cache
    echo fedora-glass | gpg --quiet -u "$fpr" --detach-sign >/dev/null || die "signing a test text failed."
    umask 022
    cat > "$units/fedora-glass-sign.service" <<UNIT
[Unit]
Description=Fedora Glass: sign and publish a new release
After=graphical-session.target

[Service]
Type=oneshot
ExecStart=$self auto
UNIT
    cat > "$units/fedora-glass-sign.timer" <<UNIT
[Unit]
Description=Fedora Glass: look for a new release to sign every 10 minutes

[Timer]
OnStartupSec=3min
OnUnitActiveSec=10min

[Install]
WantedBy=timers.target
UNIT
    systemctl --user daemon-reload
    systemctl --user enable --now fedora-glass-sign.timer
    say "Done. Each new release is now signed and published by itself while you are logged in."
    echo "You get a notification when it's done. To stop: fedora-glass-sign disable-auto"
}

cmd_disable_auto() {
    systemctl --user disable --now fedora-glass-sign.timer 2>/dev/null || :
    units="${XDG_CONFIG_HOME:-$HOME/.config}/systemd/user"
    rm -f "$units/fedora-glass-sign.service" "$units/fedora-glass-sign.timer"
    systemctl --user daemon-reload 2>/dev/null || :
    say "Automatic signing is off. Sign a release by hand with: fedora-glass-sign"
}

case "${1:-}" in
    setup)  shift; cmd_setup "$@" ;;
    backup) shift; cmd_backup "$@" ;;
    auto)   cmd_auto ;;
    enable-auto)  cmd_enable_auto ;;
    disable-auto) cmd_disable_auto ;;
    -h|--help|help) sed -n '2,15p' "$0" | sed 's/^# \{0,1\}//' ;;
    *) cmd_publish "$@" ;;
esac

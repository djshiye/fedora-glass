#!/bin/sh
set -e
if [ "$1" = configure ] && [ -z "${2:-}" ]; then
    # First install: turn the dark/light watcher on for everyone's sessions.
    systemctl --global enable liquid-glass-watch.service >/dev/null 2>&1 || :
fi
if [ "$1" = configure ]; then
    # Glass on the login screen (only if a user turned it on): bring it up to this version's
    # rules with the colours of their last Apply, so no Apply or password is needed after an
    # update. Each user's own desktop parts follow at their next login (fedora-glass watch).
    /usr/libexec/liquid-glass-login-screen refresh >/dev/null 2>&1 || :
fi
command -v gtk-update-icon-cache >/dev/null 2>&1 && gtk-update-icon-cache -q /usr/share/icons/hicolor 2>/dev/null || :
exit 0

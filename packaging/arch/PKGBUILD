# Fedora Glass for Arch Linux. Built by the Release workflow and served, signed with
# Dino's own key, from the pacman repository at https://djshiye.github.io/fedora-glass/arch
pkgname=fedora-glass
pkgver=@VERSION@
pkgrel=1
pkgdesc="Glass theme for GNOME, with a customizer"
arch=('any')
url="https://github.com/djshiye/fedora-glass"
license=('MIT' 'Apache-2.0' 'GPL-3.0-or-later' 'GPL-2.0-only' 'CC-BY-SA-4.0')
depends=('python' 'python-gobject' 'pyside6' 'qt6-declarative' 'gnome-shell' 'gnome-shell-extensions'
         'glib2' 'glib2-devel' 'polkit' 'util-linux' 'dbus')
optdepends=('kvantum: glass for Qt Widgets apps'
            'adw-gtk-theme: every GTK 3 detail')
options=('!debug' '!strip')
install=fedora-glass.install
source=("$pkgname-$pkgver.tar.gz::$url/archive/v$pkgver/$pkgname-$pkgver.tar.gz")
sha256sums=('@SHA256@')

package() {
    cd "$pkgname-$pkgver"
    sh packaging/install-tree.sh "$PWD" "$pkgdir"
}

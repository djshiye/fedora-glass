post_install() {
    # Turn the dark/light watcher on for everyone's sessions.
    systemctl --global enable liquid-glass-watch.service >/dev/null 2>&1 || :
}

post_upgrade() {
    # Glass on the login screen (only if a user turned it on): bring it up to this version's
    # rules with the colours of their last Apply, so no Apply or password is needed after an
    # update. Each user's own desktop parts follow at their next login (fedora-glass watch).
    /usr/libexec/liquid-glass-login-screen refresh >/dev/null 2>&1 || :
}

pre_remove() {
    # Off for new sessions, and stopped in running ones too (as the rpm does), so a
    # logged-in person's watcher doesn't run on until they log out.
    systemctl --global disable liquid-glass-watch.service >/dev/null 2>&1 || :
    /usr/libexec/fedora-glass-stop-watchers || :
    # Removing the app (not an upgrade) puts each person's original look back, unless they
    # turned that off in the app, and the normal login screen if the glass was on there.
    /usr/libexec/fedora-glass-undo-for-users || :
    /usr/libexec/liquid-glass-login-screen undo >/dev/null 2>&1 || :
    # The glass login screen back to plain GNOME while its add-on still exists (pre_remove
    # runs on removal only, never on an upgrade; the boot-time guard handles those).
    # A failed off must never fail the removal, but leaves locked keys behind and no tool
    # to take them away: say how to finish by hand.
    if ! /usr/libexec/fedora-glass-login off >/dev/null; then
        echo "fedora-glass: the glass login screen could not be switched off completely." >&2 || :
        echo "fedora-glass: to finish by hand, delete /etc/dconf/db/*.d/90-fedora-glass-login, /etc/dconf/db/*.d/locks/90-fedora-glass-login, /etc/dconf/db/fedora-glass-login (if there) and /etc/fedora-glass, take the line system-db:fedora-glass-login out of /etc/dconf/profile/gdm (if there), then run: dconf update" >&2 || :
    else
        # Nothing of it is left: root's own folder for it (now only its lock file) goes too.
        rm -f /var/lib/fedora-glass/login/.lock || :
        rmdir /var/lib/fedora-glass/login /var/lib/fedora-glass 2>/dev/null || :
    fi
}

post_remove() {
    # Only on removal, never on an upgrade. The login screen helper kept its saved original
    # in this folder; the undo above deleted the files, so it is empty now. Only an empty
    # folder goes (a file left there stays).
    rmdir /var/lib/liquid-glass 2>/dev/null || :
}

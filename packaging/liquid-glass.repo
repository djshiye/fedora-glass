[liquid-glass]
name=Liquid Glass (now Fedora Glass)
baseurl=https://djshiye.github.io/fedora-glass/rpms/
enabled=1
# Only the liquid-glass package is ever taken from here, whatever else appears.
includepkgs=liquid-glass
# Published by this project's GitHub Actions from each tagged release, after
# checking the RPM against the release's SHA256SUMS. Served over HTTPS from
# GitHub Pages. The packages are not GPG-signed.
gpgcheck=0
metadata_expire=1h
skip_if_unavailable=True
